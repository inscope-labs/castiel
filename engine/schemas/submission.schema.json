{
  "type": "object",
  "required": [
    "submission_id",
    "plan_id",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9]{5}-S[0-9]{3,}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "created_at": {
      "type": "string"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "READY",
              "BLOCKED"
            ]
          },
          "blocked_reason": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
