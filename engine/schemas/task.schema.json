{
  "type": "object",
  "required": [
    "id",
    "title",
    "stage",
    "executor",
    "status",
    "acceptance",
    "deliverables",
    "verify"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{5}-[1-9][0-9]*-[0-9]{3}-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "pattern": "^[1-9][0-9]*-[1-9]$"
    },
    "executor": {
      "type": "string",
      "enum": [
        "worker",
        "operator"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "pr_open",
        "done",
        "dropped",
        "superseded"
      ]
    },
    "summary": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "task",
              "decision",
              "item"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "resolved": {
            "type": "boolean"
          }
        }
      }
    },
    "spec_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "target",
              "plan"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "read",
              "edit"
            ]
          }
        }
      }
    },
    "verify": {
      "type": "object",
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "command",
            "manual"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "string"
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "commit": {
          "type": "string"
        },
        "merge_sha": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "by",
          "at"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
