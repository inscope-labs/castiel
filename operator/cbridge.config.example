# Copy to ~/.config/cbridge/config and edit.  chmod 600 it.
# Every OWNER/PROJECT value below is a placeholder: replace it before first use.

# PRIVATE: detached private repo (NOT a fork). Agents get a token for this repo only.
PRIVATE_URL=https://github.com/OWNER/PROJECT-dev.git
PRIVATE_SLUG=OWNER/PROJECT-dev

# PUBLIC upstream: read-only for cbridge (its push URL is disabled).
UPSTREAM_URL=https://github.com/OWNER/PROJECT.git
UPSTREAM_SLUG=OWNER/PROJECT

# OUTBOX: where task-<id> branches are pushed before the PR is opened.
# If the private and public repos share an owner, a repo cannot be forked into its own owner,
# so the outbox is the upstream itself: short-lived task-<id> branches live there until merged.
# (If you later fork the upstream under a DIFFERENT owner, point these at the fork instead.)
OUTBOX_URL=https://github.com/OWNER/PROJECT.git
OUTBOX_OWNER=OWNER

# Optional
# WORKDIR=$HOME/cbridge/work
# ENGINE_WT=$HOME/cbridge/engine
# DENY_PATHS='^(engine/|plans/|\.github/)'                   # never allowed in a published task branch
# DENY_TEXT='PROJECT-dev|build-engine|plans/|submissions/'   # never allowed in commit msgs / PR text (default: private repo name + these)
# ALLOW_PATHS='^src/.*$|^README\.md$'                        # optional allowlist: refuse any changed path that does not match
# ALLOW_EMAIL_RE='@users\.noreply\.github\.com$'             # restrict author/committer emails
# GIT_NAME=cbridge
# GIT_EMAIL=cbridge@users.noreply.github.com
